<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akash.marketbriefing.publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/akashbadal/Documents/market-briefing/publish.sh</string>
    </array>

    <!-- Target: page live before the 09:00 IST pre-open.
         Briefing task fires ~08:24 and takes 5-15 min, so it's written by ~08:40.
         08:45 is the primary push (Pages needs ~2 min to build → live ~08:47).
         08:55 catches a slow research day and still beats 09:00.
         09:30 and 10:30 are backstops for a Mac that was asleep earlier.
         publish.sh exits immediately when there's nothing new, so extra runs cost nothing. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>45</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>55</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/akashbadal/Documents/market-briefing/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/akashbadal/Documents/market-briefing/launchd.err.log</string>
</dict>
</plist>
