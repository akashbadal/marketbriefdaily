<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.akash.marketbriefing.publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/akashbadal/Documents/market-briefing/publish.sh</string>
    </array>

    <!-- Briefing task fires at 09:04. Publishing at 09:30 leaves room for research to finish. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/akashbadal/Documents/market-briefing/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/akashbadal/Documents/market-briefing/launchd.err.log</string>
</dict>
</plist>
